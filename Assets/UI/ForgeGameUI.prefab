  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.94, g: 0.96, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: bcaae8af702aba94b8d80a01c01b0bd5, type: 3}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\uB098\uB9CC\uC758 \uB300\uC7A5\uAC04\uC5D0 \uC624\uC2E0 \uAC83\uC744
    \uD658\uC601\uD569\uB2C8\uB2E4.\n\n\uC5EC\uB7EC\uBD84\uC774 \uC4F4 \uCF54\uB4DC\uAC00
    \uB300\uC7A5\uC7A5\uC774\uC758 \uC791\uC5C5 \uC9C0\uC2DC\uAC00 \uB429\uB2C8\uB2E4.
    \uC7AC\uB8CC\uB97C \uACE0\uB974\uACE0, \uBD88\uB85C \uB2EC\uAD6C\uACE0, \uB9DD\uCE58\uB85C
    \uB450\uB4DC\uB9AC\uBA70 \uAC80\uC744 \uB9CC\uB4E4\uC5B4 \uBCF4\uC138\uC694.\n\n\uC644\uC131\uD488\uC744
    \uD310\uB9E4\uD574 \uACE8\uB4DC\uB97C \uBAA8\uC73C\uACE0 \uD14C\uD06C \uD2B8\uB9AC\uC5D0\uC11C
    \uC0C8\uB85C\uC6B4 \uC7AC\uB8CC\uC640 \uAE30\uB2A5\uC744 \uAD6C\uB9E4\uD558\uC138\uC694.\n\n\uC5F0\uC2B5\uC6A9
    \uC7AC\uB8CC\uB97C \uC0AC\uC6A9\uD558\uBBC0\uB85C \uC2E4\uC81C \uC7AC\uACE0\uB294
    \uC904\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
